# Copy this file to .env.local and fill in your own Supabase project values.
# Both variables are public by design: the anon key is safe to expose in the browser
# as long as your Row Level Security policies are set up (see supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
